# Firebase Web App Config
# Copy this file to .env and replace the placeholder values with your real Firebase values.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firestore Database ID
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id

# Firebase Cloud Messaging Web Push key.
# Firebase Console → Project Settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key

# Multi-section Super Admin
# Add one or multiple emails separated by comma.
VITE_SUPER_ADMIN_EMAILS=your_admin_email@gmail.com

# Cloudinary free upload setup for Notes and Previous Question.
# Use an UNSIGNED upload preset with allowed formats: pdf, jpg, jpeg, png, webp.
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_FOLDER=taskbuddy

# Gemini API
# Required only if your server/API uses Gemini.
GEMINI_API_KEY=your_gemini_api_key

# App URL
# Example local: http://localhost:5173/TaskBuddy/
# Example live: https://istiak-mahin.github.io/TaskBuddy/
APP_URL=your_app_url

# Resend API
# Required only if email reminders are enabled.
RESEND_API_KEY=your_resend_api_key

# GitHub Actions reminder automation secrets
# Add these in GitHub → Settings → Secrets and variables → Actions.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_DATABASE_ID=your_firestore_database_id
REMINDER_FROM_EMAIL=TaskBuddy <onboarding@resend.dev>
REMINDER_WINDOW_MINUTES=45
REMINDER_TIMEZONE_OFFSET_MINUTES=360

# GitHub Actions Cloudinary cleanup secrets.
# These are NOT VITE_ variables and must never be exposed in frontend code.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
