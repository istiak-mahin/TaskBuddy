# Firebase Web App Config
# Copy this file to .env and replace the placeholder values with your real Firebase values.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firestore Database ID
# Use "(default)" if you use the default Firestore database.
# Your current AI Studio database is a named database, so set that value in .env.
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id

# Multi-section Super Admin
# Add one or multiple emails separated by comma.
VITE_SUPER_ADMIN_EMAILS=carlesirodriguez7@gmail.com

# Gemini API
# Required only if your server/API uses Gemini.
GEMINI_API_KEY=your_gemini_api_key

# App URL
# Example local: http://localhost:3000
# Example live: https://istiak-mahin.github.io/TaskBuddy/
APP_URL=your_app_url

# Resend API
# Required only if email reminders are enabled.
RESEND_API_KEY=your_resend_api_key

# GitHub Actions reminder automation secrets
# Add these in GitHub → Settings → Secrets and variables → Actions.
# FIREBASE_SERVICE_ACCOUNT must be the full Firebase service-account JSON in one line.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your_project_id"}
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_DATABASE_ID=your_firestore_database_id
REMINDER_FROM_EMAIL=TaskBuddy <onboarding@resend.dev>
REMINDER_WINDOW_MINUTES=35
