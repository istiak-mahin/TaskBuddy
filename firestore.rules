rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return isAuthenticated()
        && request.auth.token.email == "carlesirodriguez7@gmail.com";
    }

    function hasUserDoc() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return hasUserDoc()
        ? currentUser().data.get('role', 'student')
        : 'student';
    }

    function currentSectionIds() {
      return hasUserDoc() && currentUser().data.get('sectionIds', []) is list
        ? currentUser().data.get('sectionIds', [])
        : [];
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdminEmail() ||
        (
          hasUserDoc() &&
          currentRole() in ['admin', 'superAdmin']
        )
      );
    }

    function isSectionAdmin(sectionId) {
      return isAuthenticated() && (
        isAdmin() ||
        (
          hasUserDoc() &&
          currentRole() in ['sectionAdmin', 'admin', 'superAdmin'] &&
          sectionId in currentSectionIds()
        )
      );
    }

    function isSectionMember(sectionId) {
      return isAuthenticated() && (
        isAdmin() ||
        sectionId in currentSectionIds()
      );
    }

    function isValidDateString(dateStr) {
      return dateStr is string &&
             dateStr.matches("^\\d{4}-\\d{2}-\\d{2}.*");
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidEmail(email) {
      return email is string &&
             email.matches("(?i)^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$") &&
             email.size() < 256;
    }

    function isValidUsername(username) {
      return username is string &&
             username.matches("^[a-zA-Z0-9_]{3,30}$");
    }

    function isValidUser(data) {
      let uid = data.get('uid', '');
      let name = data.get('name', '');
      let email = data.get('email', '');
      let role = data.get('role', 'student');
      let username = data.get('username', '');
      let photoURL = data.get('photoURL', '');
      let disabled = data.get('disabled', false);
      let sectionIds = data.get('sectionIds', []);
      let activeSectionId = data.get('activeSectionId', '');

      return uid is string && uid.size() >= 0 && uid.size() < 128 &&
             name is string && name.size() > 0 && name.size() < 128 &&
             (email == '' || isValidEmail(email)) &&
             role in ['student', 'admin', 'sectionAdmin', 'superAdmin'] &&
             (username == '' || isValidUsername(username)) &&
             (photoURL == '' || (photoURL is string && photoURL.size() < 1000000)) &&
             disabled is bool &&
             sectionIds is list &&
             activeSectionId is string &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || isValidDateString(data.updatedAt));
    }

    function isValidAssignment(data) {
      return hasRequiredFields(['title', 'course', 'deadline', 'userId', 'type']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.course is string && data.course.size() > 0 && data.course.size() < 100 &&
             isValidDateString(data.deadline) &&
             data.userId is string && data.userId.size() > 0 &&
             data.type in ['Quiz', 'Assignment', 'Presentation', 'Lab'] &&
             (!('completed_hours' in data) || data.completed_hours is number) &&
             (!('total_hours' in data) || data.total_hours is number) &&
             (!('urgency' in data) || data.urgency is string) &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('sectionId' in data) || data.sectionId is string) &&
             (!('syllabus' in data) || (data.syllabus is string && data.syllabus.size() < 2000)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt));
    }

    function isValidAnnouncement(data) {
      return hasRequiredFields(['title', 'content', 'priority', 'createdAt', 'createdBy']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.priority in ['normal', 'important'] &&
             (isValidDateString(data.createdAt) || data.createdAt is timestamp) &&
             data.createdBy is string &&
             (!('sectionId' in data) || data.sectionId is string);
    }

    function isValidCourse(data) {
      return hasRequiredFields(['name', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdBy is string &&
             (!('sectionId' in data) || data.sectionId is string);
    }

    function isValidSection(data) {
      return data.name is string &&
             data.name.size() > 0 &&
             data.name.size() < 100 &&
             (!('department' in data) || data.department is string) &&
             (!('semester' in data) || data.semester is string) &&
             (!('batch' in data) || data.batch is string) &&
             (!('joinCode' in data) || data.joinCode is string) &&
             (!('adminIds' in data) || data.adminIds is list) &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || isValidDateString(data.updatedAt));
    }

    function isValidOwnerSectionMove() {
      let code = request.resource.data.get('joinCodeUsed', '');
      let activeSectionId = request.resource.data.get('activeSectionId', '');
      let sectionIds = request.resource.data.get('sectionIds', []);

      return code is string &&
             code.size() > 0 &&
             activeSectionId is string &&
             activeSectionId.size() > 0 &&
             sectionIds is list &&
             sectionIds.size() == 1 &&
             sectionIds[0] == activeSectionId &&
             exists(/databases/$(database)/documents/joinCodes/$(code)) &&
             get(/databases/$(database)/documents/joinCodes/$(code)).data.sectionId == activeSectionId &&
             get(/databases/$(database)/documents/joinCodes/$(code)).data.active == true;
    }

    function isSafeOwnerUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();

      return isOwner(userId) &&
             changed.hasOnly([
               'uid',
               'name',
               'username',
               'email',
               'photoURL',
               'role',
               'sectionIds',
               'activeSectionId',
               'disabled',
               'joinCodeUsed',
               'createdAt',
               'updatedAt'
             ]) &&
             request.resource.data.get('uid', request.auth.uid) == request.auth.uid &&
             (
               request.resource.data.get('email', request.auth.token.email) == request.auth.token.email ||
               request.resource.data.get('email', '') == resource.data.get('email', '')
             ) &&
             (
               request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student') ||
               request.resource.data.get('role', 'student') == 'student'
             ) &&
             request.resource.data.get('disabled', resource.data.get('disabled', false)) == resource.data.get('disabled', false) &&
             request.resource.data.get('sectionIds', []) is list &&
             request.resource.data.get('activeSectionId', '') is string &&
             (
               !changed.hasAny(['sectionIds', 'activeSectionId', 'joinCodeUsed']) ||
               isValidOwnerSectionMove()
             );
    }

    function isValidJoinCode(data) {
      return data.code is string &&
             data.code.size() > 0 &&
             data.code.size() <= 40 &&
             data.sectionId is string &&
             data.sectionId.size() > 0 &&
             data.sectionName is string &&
             data.sectionName.size() > 0 &&
             data.active is bool &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt)) &&
             (!('updatedAt' in data) || data.updatedAt is timestamp || isValidDateString(data.updatedAt));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isAuthenticated()
                    && isValidUser(request.resource.data)
                    && (
                      isAdmin() ||
                      (
                        isOwner(userId) &&
                        request.resource.data.uid == request.auth.uid &&
                        request.resource.data.get('role', 'student') == 'student'
                      )
                    );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        isSafeOwnerUserUpdate(userId)
      );

      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow get: if isAuthenticated();

      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && username.matches("^[a-zA-Z0-9_]{3,30}$");

      allow update: if false;

      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidAssignment(request.resource.data);
      allow update: if isAdmin() && isValidAssignment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow update: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidCourse(request.resource.data);
      allow update: if isAdmin() && isValidCourse(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
                  && (
                    resource.data.userId == request.auth.uid ||
                    isAdmin()
                  );

      allow create: if isAdmin();

      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data)
                      .affectedKeys()
                      .hasOnly(['read']);

      allow delete: if isAdmin()
                    || (
                      isAuthenticated() &&
                      resource.data.userId == request.auth.uid
                    );
    }

    match /joinCodes/{code} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if (isAdmin() || isSectionAdmin(request.resource.data.sectionId)) && isValidJoinCode(request.resource.data);
      allow update: if (isAdmin() || isSectionAdmin(request.resource.data.sectionId) || isSectionAdmin(resource.data.sectionId)) && isValidJoinCode(request.resource.data);
      allow delete: if isAdmin() || isSectionAdmin(resource.data.sectionId);
    }

    match /sections/{sectionId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidSection(request.resource.data);
      allow update: if (isAdmin() || isSectionAdmin(sectionId)) && isValidSection(request.resource.data);
      allow delete: if isAdmin();

      match /students/{studentId} {
        allow read: if isSectionMember(sectionId);

        allow create: if isSectionAdmin(sectionId)
                      || (
                        isAuthenticated() &&
                        request.auth.uid == studentId
                      );

        allow update: if isSectionAdmin(sectionId)
                      || (
                        isAuthenticated() &&
                        request.auth.uid == studentId
                      );

        allow delete: if isSectionAdmin(sectionId) || isAdmin() || (isAuthenticated() && request.auth.uid == studentId);
      }

      match /assignments/{assignmentId} {
        allow read: if isSectionMember(sectionId);
        allow create: if isSectionAdmin(sectionId) && isValidAssignment(request.resource.data);
        allow update: if isSectionAdmin(sectionId) && isValidAssignment(request.resource.data);
        allow delete: if isSectionAdmin(sectionId);
      }

      match /announcements/{announcementId} {
        allow read: if isSectionMember(sectionId);
        allow create: if isSectionAdmin(sectionId) && isValidAnnouncement(request.resource.data);
        allow update: if isSectionAdmin(sectionId) && isValidAnnouncement(request.resource.data);
        allow delete: if isSectionAdmin(sectionId);
      }

      match /courses/{courseId} {
        allow read: if isSectionMember(sectionId);
        allow create: if isSectionAdmin(sectionId) && isValidCourse(request.resource.data);
        allow update: if isSectionAdmin(sectionId) && isValidCourse(request.resource.data);
        allow delete: if isSectionAdmin(sectionId);
      }

      match /notifications/{notificationId} {
        allow read: if isSectionMember(sectionId);
        allow create, update, delete: if isSectionAdmin(sectionId);
      }
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
