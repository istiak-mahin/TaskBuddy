rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - username: string (optional, starts with @)
    //   - email: string (required)
    //   - role: string (required, ['student', 'admin'])
    //   - createdAt: timestamp (optional)
    //   - photoURL: string (optional)
    //
    // Collection: assignments
    // Document ID: {assignmentId}
    // Fields:
    //   - title: string (required)
    //   - course: string (required)
    //   - deadline: string (required, ISO 8601)
    //   - userId: string (required, student UID)
    //   - type: string (required, ['Quiz', 'Assignment', 'Presentation'])
    //   - completed_hours: number (required)
    //   - total_hours: number (required)
    //   - urgency: string (required)
    //
    // Collection: announcements
    // Document ID: {announcementId}
    // Fields:
    //   - title: string (required)
    //   - content: string (required)
    //   - priority: string (required, ['normal', 'important'])
    //   - createdAt: string (required)
    //   - createdBy: string (required)
    //
    // Collection: courses
    // Document ID: {courseId}
    // Fields:
    //   - name: string (required)
    //   - createdBy: string (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "carlesirodriguez7@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'student') == 'admin')
      );
    }

    function isValidDateString(dateStr) {
      return dateStr is string &&
             dateStr.matches("^\\d{4}-\\d{2}-\\d{2}.*");
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidEmail(email) {
      return email is string && email.matches("(?i)^[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}$") && email.size() < 256;
    }

    function isValidUsername(username) {
      return username is string && username.matches("^@.*") && username.size() >= 4 && username.size() <= 30;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      let uid = data.get('uid', '');
      let name = data.get('name', '');
      let email = data.get('email', '');
      let role = data.get('role', 'student');
      let username = data.get('username', '');
      let photoURL = data.get('photoURL', '');
      let disabled = data.get('disabled', false);

      return uid is string && uid.size() > 0 && uid.size() < 128 &&
             name is string && name.size() > 0 && name.size() < 128 &&
             (email == '' || isValidEmail(email)) &&
             role in ['student', 'admin'] &&
             (username == '' || isValidUsername(username)) &&
             (photoURL == '' || (photoURL is string && photoURL.size() < 1000000)) &&
             disabled is bool &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt));
    }

    function isValidAssignment(data) {
      return hasRequiredFields(['title', 'course', 'deadline', 'userId', 'type']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.course is string && data.course.size() > 0 && data.course.size() < 100 &&
             isValidDateString(data.deadline) &&
             data.userId is string && data.userId.size() > 0 &&
             data.type in ['Quiz', 'Assignment', 'Presentation', 'Lab'] &&
             (!('completed_hours' in data) || data.completed_hours is number) &&
             (!('total_hours' in data) || data.total_hours is number) &&
             (!('urgency' in data) || data.urgency is string) &&
             (!('createdBy' in data) || data.createdBy is string) &&
             (!('syllabus' in data) || (data.syllabus is string && data.syllabus.size() < 2000)) &&
             (!('createdAt' in data) || data.createdAt is timestamp || isValidDateString(data.createdAt));
    }

    function isValidAnnouncement(data) {
      return hasRequiredFields(['title', 'content', 'priority', 'createdAt', 'createdBy']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() < 5000 &&
             data.priority in ['normal', 'important'] &&
             (isValidDateString(data.createdAt) || data.createdAt is timestamp) &&
             data.createdBy is string;
    }

    function isValidCourse(data) {
      return hasRequiredFields(['name', 'createdBy']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.createdBy is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isAuthenticated() && 
                      isValidUser(request.resource.data) && 
                      (isAdmin() || (isOwner(userId) && request.resource.data.get('role', 'student') == 'student'));
      
      allow update: if isAuthenticated() && (
                      isAdmin() || (
                        isOwner(userId) && 
                        // Lock sensitive fields for non-admins
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['uid', 'email', 'disabled']) &&
                        // Ensure role hasn't changed
                        request.resource.data.get('role', 'student') == resource.data.get('role', 'student') &&
                        isValidUser(request.resource.data)
                      )
                    );
    }

    match /usernames/{username} {
      // Allow anyone to check if a username exists
      allow get: if isAuthenticated();
      
      // Create: If the username doesn't exist AND the user is mapping it to their own UID
      allow create: if isAuthenticated() && 
                      request.resource.data.uid == request.auth.uid &&
                      username.matches("^@.*") && username.size() >= 4;
      
      // Update: Not allowed (should delete and recreate)
      allow update: if false;
      
      // Delete: Only owner can delete their username mapping
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      // All authenticated users can read assignments (as requested: "all user can only see that")
      allow read: if isAuthenticated();
      
      // Only admins can create assignments
      allow create: if isAdmin() && isValidAssignment(request.resource.data);
      
      // Only admins can update assignments (as requested: "all user can only see that")
      allow update: if isAdmin() && isValidAssignment(request.resource.data);
      
      // Only admins can delete assignments
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow update: if isAdmin() && isValidAnnouncement(request.resource.data);
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidCourse(request.resource.data);
      allow update: if isAdmin() && isValidCourse(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
